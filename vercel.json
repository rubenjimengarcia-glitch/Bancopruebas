{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "bancodeprueba.es" }],
      "destination": "https://bancodeprueba.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.bancodeprueba.es" }],
      "destination": "https://bancodeprueba.com/:path",
      "permanent": true
    }
  ]
}
