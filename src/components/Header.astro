---
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Banco de Prueba, inicio">
      <svg class="vise" viewBox="0 0 40 24" aria-hidden="true">
        <rect x="1" y="16" width="38" height="5" rx="1" />
        <rect x="6" y="4" width="7" height="12" rx="1" />
        <rect x="27" y="4" width="7" height="12" rx="1" />
        <rect x="13" y="8" width="14" height="3" />
      </svg>
      <span>Banco de Prueba</span>
    </a>
    <nav aria-label="Principal">
      <a href="/#guias" class="plain">Guías</a>
      <a
        href="/plataformas-bateria-18v/"
        class="cta"
        aria-current={path.startsWith('/plataformas-bateria-18v/') ? 'page' : undefined}
      >
        Elegir plataforma
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #ffffff;
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 2px 10px rgba(20, 22, 26, 0.06);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--graphite);
    text-decoration: none;
    font-weight: 900;
    font-size: 1.3rem;
    font-variation-settings: 'wdth' 110;
    letter-spacing: -0.01em;
  }
  .vise {
    width: 38px;
    height: 24px;
    fill: var(--chalk);
  }
  .vise rect:last-child {
    fill: var(--graphite);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .plain {
    color: var(--graphite);
    text-decoration: none;
    font-weight: 700;
    padding: 6px 0;
    border-bottom: 3px solid transparent;
  }
  .plain:hover {
    border-bottom-color: var(--chalk);
  }
  .cta {
    background: var(--chalk);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: var(--t-sm);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.8em 1.3em;
    border-radius: 3px;
  }
  .cta:hover {
    background: #a50d17;
  }
  @media (max-width: 520px) {
    .brand span {
      font-size: 1.05rem;
    }
    .cta {
      padding: 0.7em 0.9em;
    }
    nav {
      gap: 14px;
    }
  }
</style>
