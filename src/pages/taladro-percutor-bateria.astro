---
import Base from '../layouts/Base.astro';
import AmazonButton from '../components/AmazonButton.astro';
import { AMAZON_DISCLOSURE, SITE } from '../config';

const updated = '2026-10-18';
const updatedLabel = '18 de octubre de 2026';

interface Product {
  award: string;
  name: string;
  platform: string;
  asin: string;
  kitLabel: string;
  tested: boolean;
  why: string;
  pros: string[];
  cons: string[];
  specs: { torque: string; motor: string; concrete: string; kit: string };
}

// Datos tomados de fichas de fabricante y de los anuncios de Amazon.es el 18/10/2026.
// Ninguno está probado por nosotros todavía: `tested` debe seguir en false hasta que lo estén.
const products: Product[] = [
  {
    award: 'El más equilibrado para casa',
    name: 'Bosch UniversalImpact 18V-60',
    platform: 'Bosch verde (Power for All)',
    asin: 'B09MTPGVBH',
    kitLabel: 'Kit con 2 baterías de 2,0 Ah, cargador y maletín',
    tested: false,
    why: 'Motor sin escobillas, 60 Nm y un kit que ya incluye dos baterías, cargador y maletín. La batería es de la alianza Power for All, así que también sirve en herramientas de jardín de otras marcas de la alianza. Es la opción más redonda si no tienes ninguna batería todavía.',
    pros: [
      'Motor sin escobillas y 60 Nm de par máximo',
      'Dos baterías incluidas: puedes trabajar mientras la otra carga',
      'Batería compatible con la alianza Power for All',
    ],
    cons: [
      'Las baterías de 2,0 Ah se agotan pronto con trabajos largos en pared',
      'La gama verde no está pensada para uso diario de obra',
    ],
    specs: { torque: '60 Nm', motor: 'Sin escobillas', concrete: '13 mm', kit: '2 baterías 2,0 Ah + cargador + maletín' },
  },
  {
    award: 'Para empezar una colección con jardín',
    name: 'Einhell TP-CD 18/60 Li-i BL',
    platform: 'Einhell Power X-Change',
    asin: 'B09XFR6N12',
    kitLabel: 'Solo cuerpo, sin batería ni cargador',
    tested: false,
    why: 'Taladro sin escobillas de 60 Nm que se vende sin batería. Tiene sentido si ya tienes baterías Power X-Change o si vas a empezar por una de sus herramientas de jardín y quieres que el taladro use la misma batería.',
    pros: [
      'Motor sin escobillas y 60 Nm de par máximo',
      'Una misma batería mueve muchas herramientas de casa y jardín Einhell',
      'Mandril metálico de 13 mm de una sola manga',
    ],
    cons: [
      'Se vende solo cuerpo: necesitas comprar aparte batería y cargador',
      'En hormigón su ficha indica 10 mm, algo menos que los demás de la comparativa',
    ],
    specs: { torque: '60 Nm', motor: 'Sin escobillas', concrete: '10 mm', kit: 'Solo cuerpo' },
  },
  {
    award: 'Kit completo para uso ocasional',
    name: 'Ryobi R18PD3-242S',
    platform: 'Ryobi ONE+',
    asin: 'B07Q2FKR6X',
    kitLabel: 'Kit con baterías de 2,0 y 4,0 Ah, cargador y bolsa',
    tested: false,
    why: 'La versión con escobillas del taladro percutor de Ryobi, con 50 Nm y 24 niveles de par. El kit trae dos baterías de capacidades distintas, una de 4,0 Ah que da más autonomía. Está pensado para montar muebles, colgar estanterías y hacer algún agujero en pared, sin pretensiones de obra.',
    pros: [
      'Kit con dos baterías, una de 4,0 Ah',
      '24 niveles de par para atornillar sin pasarte',
      'Toda la gama ONE+ comparte batería, también la de jardín',
    ],
    cons: [
      'Motor con escobillas: menos eficiente y con más desgaste que uno sin escobillas',
      'Es el de menos par de la comparativa (50 Nm)',
    ],
    specs: { torque: '50 Nm', motor: 'Con escobillas', concrete: '—', kit: '2 baterías (2,0 + 4,0 Ah) + cargador + bolsa' },
  },
  {
    award: 'Para crecer hacia el taller o la obra',
    name: 'Makita DHP484',
    platform: 'Makita LXT',
    asin: 'B0CD1279QD',
    kitLabel: 'Kit RFJ con batería de 3 Ah, cargador y maletín Makpac (el anuncio no indica cuántas baterías trae: compruébalo antes de comprar)',
    tested: false,
    why: 'Compacto, sin escobillas y con 54 Nm. Su gran argumento es la plataforma LXT: es de las gamas de 18 V más amplias que existen, con herramienta de taller, jardín y limpieza. Compensa si prevés ampliar con sierras, lijadoras o atornilladores de impacto, y también existe solo cuerpo (DHP484Z) para quien ya tiene baterías.',
    pros: [
      'Motor sin escobillas y 1,6 kg sin batería',
      'Mandril de 13 mm y 38 mm en madera',
      'Plataforma LXT muy extensa',
    ],
    cons: [
      'Las baterías de Makita LXT solo sirven en herramientas Makita LXT',
      'Su par (54 Nm) queda por debajo de Bosch, Einhell y DeWalt',
    ],
    specs: { torque: '54 Nm', motor: 'Sin escobillas', concrete: '13 mm', kit: 'Kit RFJ: batería 3 Ah + cargador + Makpac' },
  },
  {
    award: 'El de más par de la comparativa',
    name: 'DeWalt DCD796D2',
    platform: 'DeWalt XR',
    asin: 'B01BU0GH5U',
    kitLabel: 'Kit con 2 baterías de 2,0 Ah, cargador y maletín TStak',
    tested: false,
    why: 'El más potente de los cinco, con 70 Nm, y ultracompacto. Es una herramienta de gama profesional, así que tiene sentido si vas a usarla con frecuencia o si quieres una plataforma profesional que compartes con sus baterías FlexVolt.',
    pros: [
      '70 Nm, el par máximo más alto de esta comparativa',
      'Motor sin escobillas y transmisión metálica de dos velocidades',
      '40 mm en madera, 13 mm en hormigón y 13 mm en metal',
    ],
    cons: [
      'Es profesional: pagas por una potencia que en casa quizá no uses',
      'Las baterías de 2,0 Ah del kit son justas para trabajos largos',
    ],
    specs: { torque: '70 Nm', motor: 'Sin escobillas', concrete: '13 mm', kit: '2 baterías 2,0 Ah + cargador + maletín TStak' },
  },
];

const faqs = [
  {
    q: '¿Un taladro percutor a batería puede perforar hormigón?',
    a: 'Sí, pero con límites. Los modelos de esta guía cuyo fabricante lo indica dan entre 10 y 13 mm en hormigón, que sirve para algún taco o un tornillo de anclaje. Si vas a taladrar hormigón con frecuencia o con brocas gruesas, necesitas un martillo perforador SDS-plus, no un taladro percutor.',
  },
  {
    q: '¿Qué diferencia hay entre taladro atornillador y taladro percutor?',
    a: 'El percutor añade un modo de percusión que golpea la broca mientras gira, y se usa para ladrillo, piedra y hormigón ligero. Se puede desactivar para taladrar madera y metal y atornillar como un taladro normal.',
  },
  {
    q: '¿Cuántos Nm necesito para casa?',
    a: 'Para colgar estanterías, montar muebles y hacer agujeros de vez en cuando basta con 50 a 60 Nm. Más par ayuda con brocas grandes y tornillos largos, pero el mandril y la batería importan tanto como el número.',
  },
  {
    q: '¿Compensa pagar un motor sin escobillas?',
    a: 'Si lo vas a usar a menudo, sí: es más eficiente, aprovecha mejor la batería y dura más. Para un uso de pocas veces al año, uno con escobillas hace el trabajo y cuesta menos.',
  },
  {
    q: '¿Es mejor comprar el kit o solo el cuerpo?',
    a: 'Si no tienes baterías de esa marca, el kit. Si ya las tienes, solo cuerpo: la herramienta sale más barata y no acumulas cargadores. Antes de decidirlo, mira la guía de plataformas de batería.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'El mejor taladro percutor a batería para casa: 5 modelos comparados',
    inLanguage: 'es-ES',
    dateModified: updated,
    author: { '@type': 'Person', name: SITE.author },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="El mejor taladro percutor a batería para casa: 5 modelos"
  description="Bosch, Einhell, Ryobi, Makita y DeWalt comparados: par, motor y qué incluye cada kit, para elegir el taladro percutor a batería de 18 V que te conviene en casa."
  jsonLd={jsonLd}
>
  <article class="wrap cmp">
    <header class="head">
      <h1>El mejor taladro percutor a batería para casa</h1>
      <p class="meta">Por {SITE.author}. Actualizado el <time datetime={updated}>{updatedLabel}</time>.</p>
      <p class="lede">
        Si no tienes baterías de ninguna marca, el Bosch UniversalImpact 18V-60 es la opción más
        equilibrada: sin escobillas, 60 Nm y dos baterías en el kit. Si ya tienes baterías de otra
        marca, quédate en ella y compra el taladro solo cuerpo.
      </p>
    </header>

    <p class="note">
      Cómo hemos hecho esta comparativa: los datos salen de las fichas de los fabricantes y de los
      anuncios de Amazon.es, y ninguno de estos cinco modelos lo hemos probado todavía. Cuando lo
      hagamos, lo indicaremos aquí. <a href="/metodo/">Así trabajamos</a>.
    </p>

    <section aria-labelledby="quick-h" class="quick">
      <h2 id="quick-h">Veredicto rápido</h2>
      <ul>
        {
          products.map((p) => (
            <li>
              <span class="award">{p.award}</span>
              <span class="pname">{p.name}</span>
              <AmazonButton asin={p.asin} />
            </li>
          ))
        }
      </ul>
    </section>

    <h2>Comparativa</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Modelo</th>
            <th scope="col">Plataforma</th>
            <th scope="col">Par máx.</th>
            <th scope="col">Motor</th>
            <th scope="col">Hormigón</th>
            <th scope="col">Qué incluye</th>
            <th scope="col">Probado</th>
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                <td>{p.platform}</td>
                <td>{p.specs.torque}</td>
                <td>{p.specs.motor}</td>
                <td>{p.specs.concrete}</td>
                <td>{p.specs.kit}</td>
                <td>{p.tested ? 'Sí' : 'No, analizado'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="meta">
      Hormigón: diámetro máximo que indica el fabricante. La ficha de Ryobi no lo recoge y por eso
      aparece sin dato.
    </p>

    {
      products.map((p) => (
        <section class="pick">
          <h2>
            {p.award}: {p.name}
          </h2>
          <p class="meta">
            {p.platform}. {p.tested ? 'Probado por nosotros.' : 'Analizado por ficha técnica y anuncio de Amazon.'}
            {' '}Versión enlazada: {p.kitLabel}.
          </p>
          <div class="prose">
            <p>{p.why}</p>
          </div>
          <div class="pc">
            <div>
              <h3>A favor</h3>
              <ul>{p.pros.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h3>En contra</h3>
              <ul>{p.cons.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <AmazonButton asin={p.asin} />
        </section>
      ))
    }

    <div class="prose">
      <h2>Cómo elegir</h2>
      <ol class="steps">
        <li>
          <strong>Empieza por la batería.</strong> Si ya tienes baterías de una marca, compra el
          taladro solo cuerpo de esa marca. Si no, la plataforma que elijas decide tus próximas
          compras: lo explicamos en la <a href="/plataformas-bateria-18v/">guía de plataformas de
          batería de 18 V</a>.
        </li>
        <li>
          <strong>¿Atornillas mucho?</strong> Si además de taladrar atornillas a menudo, mira la
          <a href="/atornillador-impacto-o-taladro/">guía de atornillador de impacto o taladro</a>.
        </li>
        <li>
          <strong>Mira el uso real.</strong> Colgar estanterías y montar muebles pide 50 a 60 Nm.
          Si taladras pared con frecuencia o usas brocas gruesas, sube a un modelo profesional.
        </li>
        <li>
          <strong>Decide si pagas el motor sin escobillas.</strong> Compensa con uso frecuente. Con
          uso de pocas veces al año, uno con escobillas hace el mismo trabajo.
        </li>
        <li>
          <strong>Comprueba qué incluye.</strong> Un kit con dos baterías te evita esperas, pero si
          ya tienes baterías pagas de más por unas que no necesitas.
        </li>
      </ol>

      <h2>Antes de comprar</h2>
      <p>
        Comprueba en la ficha de Amazon quién vende y envía el producto: lo ideal es Amazon o la
        tienda oficial de la marca, para tener la garantía del fabricante. El vendedor puede cambiar
        de un día para otro y no podemos asegurar cuál será cuando entres.
      </p>

      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <section class="faq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </section>
        ))
      }

      <p class="note">
        Esta comparativa se basa en las fichas de los fabricantes y en los anuncios de Amazon.es a
        fecha de {updatedLabel}. No incluye precios porque cambian a diario. {AMAZON_DISCLOSURE}
      </p>
    </div>
  </article>
</Base>

<style>
  .cmp {
    padding-top: clamp(32px, 6vw, 64px);
  }
  .head {
    max-width: 760px;
  }
  .head h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-variation-settings: 'wdth' 64;
    line-height: 0.98;
  }
  .head .lede {
    margin-top: 20px;
    color: var(--graphite);
    border-left: 4px solid var(--chalk);
    padding-left: 16px;
  }
  .quick ul {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--graphite);
    max-width: 880px;
  }
  .quick li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 8px 20px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .award {
    color: var(--steel);
  }
  .pname {
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
    font-size: var(--t-md);
  }
  .pick {
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
    max-width: 880px;
  }
  .pc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 16px;
  }
  .pc h3 {
    margin-top: 0.4em;
  }
  .steps {
    padding-left: 1.4em;
  }
  .steps li::marker {
    font-weight: 800;
    color: var(--chalk);
  }
  .faq h3 {
    font-size: 1.15rem;
  }
  @media (max-width: 720px) {
    .quick li,
    .pc {
      grid-template-columns: 1fr;
    }
  }
</style>
