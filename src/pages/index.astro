---
import Base from '../layouts/Base.astro';
import PlatformPicker from '../components/PlatformPicker.astro';
import { SITE } from '../config';

const guides = [
  {
    href: '/plataformas-bateria-18v/',
    title: 'Qué plataforma de batería de 18 V elegir',
    text: 'La decisión que condiciona todas tus compras siguientes, explicada sin marca favorita.',
    ready: true,
  },
  {
    href: '/taladro-percutor-bateria/',
    title: 'Taladro percutor a batería para casa',
    text: 'Cinco modelos comparados para colgar cuadros, montar muebles o hacer algún agujero en pared.',
    ready: true,
  },
  {
    href: '/herramientas-sin-bateria/',
    title: 'Herramientas sin batería: cuándo compensan',
    text: 'Qué significa comprar solo el cuerpo y cuatro taladros a batería sin batería incluida, según anuncio, para quien ya tiene baterías y cargador.',
    ready: true,
  },
  {
    href: '/atornillador-impacto-o-taladro/',
    title: 'Atornillador de impacto o taladro',
    text: 'Qué hace cada uno, cuándo necesitas los dos y cinco atornilladores de impacto comparados.',
    ready: true,
  },
  {
    href: '/regalos-bricolaje-navidad/',
    title: 'Regalos de bricolaje para Navidad',
    text: 'Cuatro taladros a batería en kit, con batería y cargador, para regalar sin saber qué plataforma tiene la persona.',
    ready: true,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es-ES',
  description: SITE.description,
};
---

<Base title={SITE.name} jsonLd={jsonLd}>
  <div class="band">
    <section class="hero wrap">
      <div class="copy">
        <p class="eyebrow">Herramientas a batería para casa</p>
        <h1>Elige una batería. Acierta con todo lo que compres después.</h1>
        <p class="lede">
          Guías y comparativas de herramientas eléctricas a batería para casa, ordenadas por
          plataforma: Bosch, Makita, Einhell, Ryobi y DeWalt.
        </p>
        <a class="hero-cta" href="/plataformas-bateria-18v/">Elegir mi plataforma</a>
      </div>
      <div class="picker">
        <PlatformPicker />
      </div>
    </section>
  </div>

  <section class="wrap start" id="guias" aria-labelledby="start-h">
    <h2 id="start-h">Por dónde empezar</h2>
    <ul class="cards">
      {
        guides.map((g, i) => (
          <li class={g.ready ? 'card' : 'card soon'}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{g.ready ? <a href={g.href}>{g.title}</a> : g.title}</h3>
            <p>{g.text}</p>
            <span class="state">{g.ready ? 'Leer guía →' : 'En preparación'}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap how" aria-labelledby="how-h">
    <h2 id="how-h">Cómo recomendamos</h2>
    <div class="how-grid">
      <p>
        <strong>Sin marca favorita.</strong> Recomendamos por el trabajo que vas a hacer y por la batería
        que ya tienes, no por quién paga más.
      </p>
      <p>
        <strong>Datos con fuente.</strong> Cada cifra sale de la ficha del fabricante o del anuncio de
        la tienda, y la fecha de consulta figura en cada guía.
      </p>
      <p>
        <strong>Sin precios caducados.</strong> Los precios cambian a diario; te llevamos a la tienda para
        que veas el actual.
      </p>
    </div>
  </section>
</Base>

<style>
  .band {
    background: linear-gradient(105deg, var(--chalk) 0 55%, var(--panel) 55% 100%);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .copy {
    color: #ffffff;
  }
  .eyebrow {
    margin: 0 0 14px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-bottom: 0.5em;
    color: #ffffff;
  }
  .copy .lede {
    color: #ffffff;
    margin-bottom: 28px;
  }
  .hero-cta {
    display: inline-block;
    background: #ffffff;
    color: var(--chalk);
    font-weight: 800;
    font-size: var(--t-sm);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1em 1.6em;
    border-radius: 3px;
  }
  .hero-cta:hover {
    background: #14161a;
    color: #ffffff;
  }
  .picker {
    box-shadow: 0 18px 40px rgba(20, 22, 26, 0.18);
    border-radius: 6px;
  }
  .start,
  .how {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-top: 6px solid var(--chalk);
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(20, 22, 26, 0.06);
  }
  .card h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .card h3 a {
    color: var(--graphite);
    text-decoration: none;
  }
  .card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover {
    box-shadow: 0 10px 26px rgba(20, 22, 26, 0.14);
  }
  .card p {
    margin: 0;
    color: var(--steel);
    font-size: var(--t-sm);
  }
  .num {
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--chalk);
  }
  .state {
    margin-top: auto;
    padding-top: 10px;
    font-weight: 800;
    font-size: var(--t-sm);
    color: var(--chalk);
  }
  .card.soon {
    background: var(--panel);
    border-top-color: var(--peg);
    box-shadow: none;
  }
  .card.soon .state {
    color: var(--steel);
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    max-width: 1000px;
  }
  .how-grid p {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .how-grid strong {
    display: block;
    font-weight: 900;
    font-size: var(--t-md);
    margin-bottom: 4px;
  }
  @media (max-width: 880px) {
    .band {
      background: linear-gradient(180deg, var(--chalk) 0 62%, var(--panel) 62% 100%);
    }
    .hero {
      grid-template-columns: 1fr;
    }
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
