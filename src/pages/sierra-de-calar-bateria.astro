---
import Base from '../layouts/Base.astro';
import AmazonButton from '../components/AmazonButton.astro';
import { AMAZON_DISCLOSURE, SITE } from '../config';

const updated = '2026-11-25';
const updatedLabel = '25 de noviembre de 2026';

interface Product {
  award: string;
  name: string;
  platform: string;
  asin: string;
  why: string;
  pros: string[];
  cons: string[];
  notFor: string;
  specs: { corte: string; escobillas: string; nota: string };
}

// Datos de los anuncios de Amazon.es abiertos el 25/11/2026 (ver agentes/dossiers/sierra-de-calar-bateria.md).
const products: Product[] = [
  {
    award: 'Bosch',
    name: 'Bosch UniversalSaw 18V-100',
    platform: 'Bosch 18 V',
    asin: 'B09BJXZF46',
    why: 'El anuncio indica péndulo de 4 pasos y una profundidad de corte de hasta 100 mm en madera, un 25 % más que el modelo anterior según el propio anuncio. Incluye 2 hojas, tapa antipolvo, protección antiastillas y caja.',
    pros: ['Hasta 100 mm en madera según el anuncio', 'Incluye 2 hojas de sierra, según el anuncio', 'El 25/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Se entrega sin batería',
      'No hemos recogido su peso ni su velocidad',
    ],
    notFor: 'No es para ti si necesitas conocer el peso o la velocidad antes de comprar: no los hemos recogido.',
    specs: { corte: '100 mm', escobillas: 'No recogido', nota: 'Amazon' },
  },
  {
    award: 'Einhell',
    name: 'Einhell TE-JS 18/100 Li-Solo',
    platform: 'Einhell Power X-Change 18 V',
    asin: 'B0DZNPG373',
    why: 'El título del anuncio indica 100 mm de corte, 26 mm de carrera, hasta 3.000 carreras/min y cortes oblicuos de 45°. El texto añade 12 mm en acero, carrera pendular conmutable y portahojas sin herramientas.',
    pros: ['Hasta 100 mm en madera y 12 mm en acero según el anuncio', 'Portahojas sin herramientas según el anuncio', 'El 25/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Se entrega sin batería',
      'Incluye una sola hoja, para madera',
      'No hemos recogido su peso',
    ],
    notFor: 'No es para ti si vas a cortar metal con frecuencia y necesitas hojas incluidas: el anuncio habla de una hoja para madera.',
    specs: { corte: '100 mm', escobillas: 'No recogido', nota: 'Amazon' },
  },
  {
    award: 'DeWalt',
    name: 'DeWalt DCS334N-XJ',
    platform: 'DeWalt 18 V XR',
    asin: 'B07JQ6S5SB',
    why: 'El título del anuncio indica motor sin escobillas, XR 18 V y que se vende sin cargador ni batería. El texto añade soplador de polvo, luz LED y acción pendular de 4 posiciones.',
    pros: ['Sin escobillas según el título del anuncio', 'Soplador de polvo y luz LED según el anuncio', 'El 25/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Sin batería ni cargador',
      'No hemos recogido su profundidad de corte, su peso ni su velocidad',
    ],
    notFor: 'No es para ti si necesitas saber la profundidad de corte antes de comprar: no la hemos podido confirmar.',
    specs: { corte: 'No recogido', escobillas: 'Sí', nota: 'Amazon' },
  },
  {
    award: 'Makita',
    name: 'Makita DJV185Z',
    platform: 'Makita 18 V',
    asin: 'B0C2JYX3HD',
    why: 'El anuncio indica 18 V, sin batería ni cargador, luz LED, interruptor bloqueable y bloqueo de hoja sin herramientas con una mano. Menciona también protección XPT contra polvo y salpicaduras de agua.',
    pros: ['Hoja con bloqueo sin herramientas según el anuncio', 'Protección XPT contra polvo y salpicaduras según el anuncio', 'El 25/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Sin batería ni cargador',
      'No hemos recogido su profundidad de corte, su peso ni su velocidad',
    ],
    notFor: 'No es para ti si necesitas conocer la profundidad de corte antes de comprar: no la hemos podido confirmar.',
    specs: { corte: 'No recogido', escobillas: 'No recogido', nota: 'Amazon' },
  },
];

const faqs = [
  {
    q: '¿Necesito comprar la batería aparte?',
    a: 'Sí: los cuatro anuncios dicen que se venden sin batería. Elige una batería de la plataforma de tu herramienta según su manual.',
  },
  {
    q: '¿Sirve una batería de otra marca?',
    a: 'No lo damos por hecho: nuestros datos no dicen nada sobre compatibilidad entre marcas. Comprueba la compatibilidad en el manual del fabricante o en la ficha del producto.',
  },
  {
    q: '¿Qué profundidad de corte necesito?',
    a: 'La Bosch y la Einhell indican hasta 100 mm en madera; en la DeWalt y la Makita no la hemos recogido. Mira en el manual del fabricante para qué materiales y grosores está prevista cada sierra.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Mejor sierra de calar a batería (4 modelos, según anuncio)',
    inLanguage: 'es-ES',
    dateModified: updated,
    author: { '@type': 'Person', name: SITE.author },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="Mejor sierra de calar a batería"
  description="Cuatro sierras de calar a batería (Bosch, Einhell, DeWalt y Makita) comparadas por sus anuncios: profundidad de corte cuando consta y vendedor."
  jsonLd={jsonLd}
>
  <article class="wrap cmp">
    <header class="head">
      <h1>Mejor sierra de calar a batería</h1>
      <p class="meta">Por {SITE.author}. Actualizado el <time datetime={updated}>{updatedLabel}</time>.</p>
      <p class="lede">
        Aquí tienes cuatro sierras de calar a batería de Amazon.es, analizadas por su anuncio:
        Bosch, Einhell, DeWalt y Makita. Veredicto: según los anuncios, la Bosch UniversalSaw 18V-100
        y la Einhell TE-JS 18/100 indican hasta 100 mm de corte en madera; en la DeWalt y la Makita
        no hemos recogido ese dato. Con estos datos no elegimos una ganadora absoluta: elige según
        las baterías que ya tengas.
      </p>
    </header>

    <section aria-labelledby="quick-h" class="quick">
      <h2 id="quick-h">Veredicto rápido</h2>
      <ul>
        {
          products.map((p) => (
            <li>
              <span class="award">{p.award}</span>
              <span class="pname">{p.name}</span>
              <AmazonButton asin={p.asin} label="Ver en Amazon.es" />
            </li>
          ))
        }
      </ul>
    </section>

    <h2>Comparativa</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Modelo</th>
            <th scope="col">Corte en madera</th>
            <th scope="col">Sin escobillas</th>
            <th scope="col">Vendedor el 25/11/2026</th>
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                <td>{p.specs.corte}</td>
                <td>{p.specs.escobillas}</td>
                <td>{p.specs.nota}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="meta">Datos según los anuncios de Amazon.es del {updatedLabel}, igual que el ASIN y el vendedor. "No recogido" significa que no lo hemos podido confirmar en el anuncio.</p>

    {
      products.map((p) => (
        <section class="pick">
          <p class="kicker">{p.award}</p>
          <h2 class="pick-title">{p.name}</h2>
          <p class="meta">{p.platform}.</p>
          <div class="prose">
            <p>{p.why}</p>
          </div>
          <div class="pc">
            <div>
              <h3>A favor</h3>
              <ul>{p.pros.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h3>En contra</h3>
              <ul>{p.cons.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <p class="notfor"><strong>Para quién NO es:</strong> {p.notFor}</p>
          <AmazonButton asin={p.asin} label="Ver en Amazon.es" />
        </section>
      ))
    }

    <div class="prose">
      <h2>Cómo decidir</h2>
      <ol class="steps">
        <li>
          <strong>Mira tu plataforma.</strong> Piensa en las baterías que ya tengas. Si aún
          no tienes, la <a href="/plataformas-bateria-18v/">guía de plataformas de 18 V</a> te ayuda
          a elegir.
        </li>
        <li>
          <strong>Compara la profundidad de corte</strong> en la tabla, teniendo en cuenta que en la DeWalt
          y la Makita no la hemos podido confirmar.
        </li>
        <li>
          <strong>Elige la batería.</strong> Mira la guía de
          <a href="/bateria-2ah-o-4ah/">baterías de 2 Ah o 4 Ah</a> o la de
          <a href="/kit-combo-herramientas-bateria/">kits combo</a>.
        </li>
      </ol>

      <h2>Antes de comprar</h2>
      <p>
        Comprueba en la ficha de Amazon quién vende y envía el producto. El vendedor puede cambiar de un día para otro y no podemos asegurar cuál
        será cuando entres.
      </p>

      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <section class="faq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </section>
        ))
      }

      <p class="note">
        Esta guía se basa en los anuncios de Amazon.es del {updatedLabel}; los ASIN y el vendedor se comprobaron ese día. No incluye
        precios. {AMAZON_DISCLOSURE}
      </p>
    </div>
  </article>
</Base>

<style>
  .cmp {
    padding-top: clamp(32px, 6vw, 64px);
  }
  .head {
    max-width: 760px;
  }
  .head h1 {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    font-variation-settings: 'wdth' 112;
    line-height: 1.05;
  }
  .head .lede {
    margin-top: 20px;
    color: var(--graphite);
    border-left: 4px solid var(--chalk);
    padding-left: 16px;
  }
  .quick ul {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--graphite);
    max-width: 880px;
  }
  .quick li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 8px 20px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .award {
    color: var(--steel);
  }
  .pname {
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
    font-size: var(--t-md);
  }
  .pick {
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
    max-width: 880px;
  }
  .pc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 16px;
  }
  .pc h3 {
    margin-top: 0.4em;
  }
  .notfor {
    margin: 0 0 16px;
    color: var(--graphite);
  }
  .steps {
    padding-left: 1.4em;
  }
  .steps li::marker {
    font-weight: 800;
    color: var(--chalk);
  }
  .faq h3 {
    font-size: 1.15rem;
  }
  @media (max-width: 720px) {
    .quick li,
    .pc {
      grid-template-columns: 1fr;
    }
  }
</style>
