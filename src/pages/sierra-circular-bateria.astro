---
import Base from '../layouts/Base.astro';
import AmazonButton from '../components/AmazonButton.astro';
import { AMAZON_DISCLOSURE, SITE } from '../config';

const updated = '2026-11-16';
const updatedLabel = '16 de noviembre de 2026';

interface Product {
  award: string;
  name: string;
  platform: string;
  asin: string;
  why: string;
  pros: string[];
  cons: string[];
  notFor: string;
  specs: { disco: string; peso: string; nota: string };
}

// Datos de los anuncios de Amazon.es abiertos el 16/11/2026 (ver agentes/dossiers/sierra-circular-bateria.md).
const products: Product[] = [
  {
    award: 'Bosch',
    name: 'Bosch GKS 18V-51',
    platform: 'Bosch 18 V',
    asin: 'B0DFWY4KKQ',
    why: 'El anuncio indica motor Brushless de 18 V, diseño compacto, arranque y parada suaves y un disco de 140 mm incluido. La ficha da 2 kg.',
    pros: ['2 kg según la ficha, el peso más bajo de esta guía', 'Motor Brushless según el anuncio', 'El 16/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Disco de 140 mm, más pequeño que los 165 mm de las otras tres',
      'No hemos recogido su profundidad de corte',
      'Anuncio sin indicar batería ni cargador: no los damos por incluidos',
    ],
    notFor: 'No es para ti si necesitas un disco de 165 mm o conocer la profundidad de corte antes de comprar.',
    specs: { disco: '140 mm', peso: '2 kg', nota: 'Amazon' },
  },
  {
    award: 'Einhell',
    name: 'Einhell TE-CS 18/165-1 Li-Solo',
    platform: 'Einhell PXC 18 V',
    asin: 'B0853SS8N3',
    why: 'El título del anuncio indica disco de 165 mm, profundidad de corte de 54 mm, ajuste sin herramientas, LED y hoja incluida, sin batería. La ficha da 2,72 kg.',
    pros: ['Ajuste de profundidad e inclinación sin herramientas según el anuncio', 'LED según el título del anuncio', 'El 16/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Se entrega sin batería ni cargador',
      '2,72 kg según la ficha: 720 g más que la Bosch GKS 18V-51',
    ],
    notFor: 'No es para ti si necesitas una sierra que se venda con batería y cargador: esta se entrega sin ellos.',
    specs: { disco: '165 mm', peso: '2,72 kg', nota: 'Amazon' },
  },
  {
    award: 'DeWalt',
    name: 'DeWalt DCS391N-XJ',
    platform: 'DeWalt 18 V XR',
    asin: 'B006XBSXAE',
    why: 'El título del anuncio indica 18 V XR, disco de 165 mm y 55 mm de profundidad, sin cargador ni batería.',
    pros: ['55 mm de profundidad de corte según el título del anuncio', 'El 16/11/2026 la vendía y enviaba Amazon'],
    cons: [
      'Sin batería ni cargador',
      'La ficha muestra peso y otros datos incoherentes y no los publicamos: compruébalos antes de comprar',
    ],
    notFor: 'No es para ti si necesitas saber su peso antes de comprar: no lo hemos podido confirmar.',
    specs: { disco: '165 mm', peso: 'No recogido', nota: 'Amazon' },
  },
  {
    award: 'Makita',
    name: 'Makita DHS680Z',
    platform: 'Makita 18 V',
    asin: 'B00WW83F4Q',
    why: 'La ficha indica 18 V, 5.000 rpm, hoja de 165 mm con 60 dientes y cambio de hoja con llave. El peso que da es 3,3 kg.',
    pros: ['Cambio de hoja con llave según la ficha', 'Hoja de 165 mm'],
    cons: [
      '3,3 kg según la ficha, 1,3 kg más que la Bosch GKS 18V-51',
      'El 16/11/2026 la vendía un vendedor externo (Cotebrico-es), no Amazon',
      'El anuncio no detalla si incluye batería ni cargador',
    ],
    notFor: 'No es para ti si priorizas el menor peso (3,3 kg según la ficha) o si necesitas saber que incluye batería y cargador: el anuncio no lo detalla.',
    specs: { disco: '165 mm', peso: '3,3 kg', nota: 'Vendedor externo' },
  },
];

const faqs = [
  {
    q: '¿Necesito comprar la batería aparte?',
    a: 'En la Einhell y la DeWalt, los anuncios dicen que se venden sin batería. En la Bosch y la Makita el anuncio no lo detalla en lo que hemos recogido. Mira la ficha antes de comprar y elige una batería de la plataforma de tu herramienta según su manual.',
  },
  {
    q: '¿Sirve una batería de otra marca?',
    a: 'No lo damos por hecho: el anuncio no dice nada sobre compatibilidad entre marcas. Comprueba la compatibilidad en el manual del fabricante o en la ficha del producto.',
  },
  {
    q: '¿Qué disco necesito?',
    a: 'La Bosch indica 140 mm y las otras tres 165 mm. Mira en el manual del fabricante qué discos admite y su uso previsto.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Mejor sierra circular a batería para casa (4 modelos, según anuncio)',
    inLanguage: 'es-ES',
    dateModified: updated,
    author: { '@type': 'Person', name: SITE.author },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="Mejor sierra circular a batería para casa"
  description="Cuatro sierras circulares a batería (Bosch, Einhell, DeWalt y Makita) comparadas por sus anuncios: disco, peso cuando consta y vendedor."
  jsonLd={jsonLd}
>
  <article class="wrap cmp">
    <header class="head">
      <h1>Mejor sierra circular a batería para casa</h1>
      <p class="meta">Por {SITE.author}. Actualizado el <time datetime={updated}>{updatedLabel}</time>.</p>
      <p class="lede">
        Aquí tienes cuatro sierras circulares a batería de Amazon.es, analizadas por su anuncio:
        Bosch, Einhell, DeWalt y Makita. Veredicto: según las fichas, la Bosch GKS 18V-51 es la más
        ligera (2 kg) pero lleva un disco de 140 mm; las otras tres usan 165 mm. No elegimos una
        ganadora absoluta con estos datos: elige según las baterías que ya tengas.
      </p>
    </header>

    <section aria-labelledby="quick-h" class="quick">
      <h2 id="quick-h">Veredicto rápido</h2>
      <ul>
        {
          products.map((p) => (
            <li>
              <span class="award">{p.award}</span>
              <span class="pname">{p.name}</span>
              <AmazonButton asin={p.asin} label="Ver en Amazon.es" />
            </li>
          ))
        }
      </ul>
    </section>

    <h2>Comparativa</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Modelo</th>
            <th scope="col">Disco</th>
            <th scope="col">Peso</th>
            <th scope="col">Vendedor el 16/11/2026</th>
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                <td>{p.specs.disco}</td>
                <td>{p.specs.peso}</td>
                <td>{p.specs.nota}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="meta">Datos según los anuncios de Amazon.es del {updatedLabel}, igual que el ASIN y el vendedor. "No recogido" significa que no lo hemos podido confirmar en el anuncio.</p>

    {
      products.map((p) => (
        <section class="pick">
          <p class="kicker">{p.award}</p>
          <h2 class="pick-title">{p.name}</h2>
          <p class="meta">{p.platform}.</p>
          <div class="prose">
            <p>{p.why}</p>
          </div>
          <div class="pc">
            <div>
              <h3>A favor</h3>
              <ul>{p.pros.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h3>En contra</h3>
              <ul>{p.cons.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <p class="notfor"><strong>Para quién NO es:</strong> {p.notFor}</p>
          <AmazonButton asin={p.asin} label="Ver en Amazon.es" />
        </section>
      ))
    }

    <div class="prose">
      <h2>Cómo decidir</h2>
      <ol class="steps">
        <li>
          <strong>Mira tu plataforma.</strong> Piensa en las baterías que ya tengas. Si aún
          no tienes, la <a href="/plataformas-bateria-18v/">guía de plataformas de 18 V</a> te ayuda
          a elegir.
        </li>
        <li>
          <strong>Compara disco y peso</strong> en la tabla, teniendo en cuenta que en la DeWalt no
          hemos podido confirmar el peso.
        </li>
        <li>
          <strong>Elige la batería.</strong> Mira la guía de
          <a href="/bateria-2ah-o-4ah/">baterías de 2 Ah o 4 Ah</a> o la de
          <a href="/kit-combo-herramientas-bateria/">kits combo</a>.
        </li>
      </ol>

      <h2>Antes de comprar</h2>
      <p>
        Comprueba en la ficha de Amazon quién vende y envía el producto. El vendedor puede cambiar de un día para otro y no podemos asegurar cuál
        será cuando entres.
      </p>

      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <section class="faq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </section>
        ))
      }

      <p class="note">
        Esta guía se basa en los anuncios de Amazon.es del {updatedLabel}; los ASIN y el vendedor se comprobaron ese día. No incluye
        precios. {AMAZON_DISCLOSURE}
      </p>
    </div>
  </article>
</Base>

<style>
  .cmp {
    padding-top: clamp(32px, 6vw, 64px);
  }
  .head {
    max-width: 760px;
  }
  .head h1 {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    font-variation-settings: 'wdth' 112;
    line-height: 1.05;
  }
  .head .lede {
    margin-top: 20px;
    color: var(--graphite);
    border-left: 4px solid var(--chalk);
    padding-left: 16px;
  }
  .quick ul {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--graphite);
    max-width: 880px;
  }
  .quick li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 8px 20px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .award {
    color: var(--steel);
  }
  .pname {
    font-weight: 700;
    font-variation-settings: 'wdth' 80;
    font-size: var(--t-md);
  }
  .pick {
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
    max-width: 880px;
  }
  .pc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 16px;
  }
  .pc h3 {
    margin-top: 0.4em;
  }
  .notfor {
    margin: 0 0 16px;
    color: var(--graphite);
  }
  .steps {
    padding-left: 1.4em;
  }
  .steps li::marker {
    font-weight: 800;
    color: var(--chalk);
  }
  .faq h3 {
    font-size: 1.15rem;
  }
  @media (max-width: 720px) {
    .quick li,
    .pc {
      grid-template-columns: 1fr;
    }
  }
</style>
